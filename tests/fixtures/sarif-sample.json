{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Veracode Static Analysis",
          "version": "25.3.0",
          "rules": [
            {
              "id": "java-sqli",
              "name": "SQLInjection",
              "shortDescription": { "text": "SQL Injection" },
              "properties": { "cwe": "CWE-89" }
            },
            {
              "id": "java-xss",
              "name": "ReflectedXSS",
              "shortDescription": { "text": "Cross-site Scripting" },
              "properties": { "cwe": ["CWE-79"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "java-sqli",
          "level": "error",
          "correlationGuid": "00000000-aaaa-bbbb-cccc-000000000001",
          "message": { "text": "Tainted data flows into a JDBC query (CWE-89)." },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/main/java/com/example/dao/UserDao.java" },
              "region": { "startLine": 87 }
            }
          }],
          "properties": { "cwe": "CWE-89" }
        },
        {
          "ruleId": "java-xss",
          "level": "warning",
          "correlationGuid": "00000000-aaaa-bbbb-cccc-000000000002",
          "message": { "text": "User-controlled value rendered without escaping." },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/main/webapp/views/profile.jsp" },
              "region": { "startLine": 14 }
            }
          }]
        }
      ]
    }
  ]
}
