{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Veracode Static Analysis",
          "version": "25.3.0",
          "rules": [
            {
              "id": "dotnet-sqli",
              "name": "SQLInjection",
              "shortDescription": { "text": "SQL Injection" },
              "properties": { "cwe": "CWE-89" }
            },
            {
              "id": "dotnet-xss",
              "name": "ReflectedXSS",
              "shortDescription": { "text": "Cross-site Scripting" },
              "properties": { "cwe": "CWE-79" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "dotnet-sqli",
          "level": "error",
          "correlationGuid": "dotnet-test-cs-1",
          "message": { "text": "Tainted data flows into SqlCommand." },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/MyApp/Data/UserRepository.cs" },
              "region": { "startLine": 47 }
            }
          }],
          "properties": { "cwe": "CWE-89" }
        },
        {
          "ruleId": "dotnet-xss",
          "level": "warning",
          "correlationGuid": "dotnet-test-cshtml-1",
          "message": { "text": "User-controlled value rendered without encoding." },
          "locations": [{
            "physicalLocation": {
              "artifactLocation": { "uri": "src/MyApp/Views/Account/Profile.cshtml" },
              "region": { "startLine": 14 }
            }
          }],
          "properties": { "cwe": "CWE-79" }
        }
      ]
    }
  ]
}
